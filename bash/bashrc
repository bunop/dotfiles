# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# Source global definitions
if [ -f /etc/bashrc ]; then
	. /etc/bashrc
fi

# set a different umask
umask 0002

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth:erasedups

# append to the history file, don't overwrite it
shopt -s histappend

# Write a multi lite command in a single line
shopt -s cmdhist

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTFILESIZE=10000
HISTSIZE=10000
#HISTTIMEFORMAT='%F %T '
HISTIGNORE="ls:ll:exit:clear:cd:top:htop*:history*:rm*:ht:hd*:dkps*:dkrm*:fuck:trash*:kill*"

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# Show the effective group in the prompt when it differs from the primary one (newgrp, sg).
# Unlike master, PS1 comes from /etc/bashrc: only insert the tag before the closing "]".
__primary_gid=$(id -g "$USER")
__grp_prompt() {
    __grp_tag=
    [ "${GROUPS[0]}" != "$__primary_gid" ] && __grp_tag=" [$(id -gn)]"
}
PROMPT_COMMAND="__grp_prompt${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
PS1=${PS1/\\W]/\\W\$\{__grp_tag\}]}

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias dir='dir --color=auto'
    alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# colored GCC warnings and errors
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# some more ls aliases
alias ll='ls -lh'
alias la='ls -A'
alias l='ls -CF'

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# https://medium.com/@cjus/handy-docker-aliases-4bd85089a3b8
if [ -f "$HOME/.docker_aliases" ]; then
  . "$HOME/.docker_aliases"
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# Enable auto-complete function fully
complete -cf sudo
complete -cf man

# Dedup ~/.bash_history at shell start (erasedups only works within one shell's memory)
case "$-" in
    *i*) [ -f ~/.bash_history ] && tac ~/.bash_history | awk '!x[$0]++' | tac >| ~/.bash_history.tmp && command mv -f ~/.bash_history.tmp ~/.bash_history ;;
esac

# set the default pager for terminal like psql, mysql, ...
# http://merlinmoncure.blogspot.com/2007/10/better-psql-with-less.html
# export PAGER=less
# export LESS="-iMSx4 -FX"
# export LESS="-iMSx4"

# A function to call .bash_logout even for a non-login shell
trap_exit() {
    # If this is a login shell, return 1 and skip this condition; otherwise run it.
    if ! eval shopt -q login_shell ; then
        . "$HOME/.bash_logout"
    fi
}

# call the trap_exit function when the shell exits, but only if this is an interactive
# shell (i.e. not a script)
case "$-" in *i*)
    trap trap_exit EXIT
    # The suspend and resume feature is not needed in most modern terminals,
    # and we can turn it off without any problem by typing:
    stty -ixon
esac

# enabling git completion
if [ -f "/usr/share/bash-completion/completions/git" ]; then
    . /usr/share/bash-completion/completions/git
fi

# enabling singularity completion
if [ -f "/etc/bash_completion.d/singularity" ]; then
    . /etc/bash_completion.d/singularity
fi

# enabling poetry completion
if [ -f "${HOME}/.poetry_completion" ]; then
    . "${HOME}/.poetry_completion"
fi

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# Use the following command to don't activate the default base environment
# conda config --set auto_activate_base false

# >>> mamba initialize >>>
# NOTE: This should be in `~/.bashrc` if you need conda/micromamba support
# when using not login shells like `newgrp`
# !! Contents within this block are managed by 'micromamba shell init' !!
export MAMBA_EXE="$HOME/bin/micromamba";
export MAMBA_ROOT_PREFIX="$HOME/.conda";
__mamba_setup="$("$MAMBA_EXE" shell hook --shell bash --root-prefix "$MAMBA_ROOT_PREFIX" 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__mamba_setup"
else
    alias micromamba="$MAMBA_EXE"  # Fallback on help from micromamba activate
fi
unset __mamba_setup
# <<< mamba initialize <<<

# enabling terraform completion
if command -v terraform &> /dev/null; then
    complete -C "$(command -v terraform)" terraform
fi
